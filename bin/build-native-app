#!/bin/zsh
set -euo pipefail

SCRIPT_DIR="${0:A:h}"
PROJECT_ROOT="${SCRIPT_DIR:h}"
PACKAGE_ROOT="${PROJECT_ROOT}/native-crm"
APP_BUNDLE="${PACKAGE_ROOT}/dist/Contextward.app"
CONTENTS_DIR="${APP_BUNDLE}/Contents"
MACOS_DIR="${CONTENTS_DIR}/MacOS"
RESOURCES_DIR="${CONTENTS_DIR}/Resources"

if [[ "${APP_BUNDLE}" != "${PROJECT_ROOT}/native-crm/dist/Contextward.app" ]]; then
  print -u2 "Refusing unexpected app-bundle target: ${APP_BUNDLE}"
  exit 1
fi

# Toolchain pin (F10): the Swift major.minor in native-crm/.swift-version must match.
EXPECTED_SWIFT="$(tr -d '[:space:]' < "${PACKAGE_ROOT}/.swift-version")"
ACTUAL_SWIFT="$(swift --version 2>/dev/null | sed -nE 's/.*Swift version ([0-9]+\.[0-9]+).*/\1/p' | head -1)"
if [[ "${ACTUAL_SWIFT}" != "${EXPECTED_SWIFT}" ]]; then
  print -u2 "Swift ${EXPECTED_SWIFT} is pinned in native-crm/.swift-version, found ${ACTUAL_SWIFT:-unknown}."
  print -u2 "Install the pinned toolchain or update the pin deliberately."
  exit 1
fi

"${PROJECT_ROOT}/bin/test-native-app"
swift build -c release --package-path "${PACKAGE_ROOT}"
BIN_DIR="$(swift build -c release --show-bin-path --package-path "${PACKAGE_ROOT}")"

if [[ -d "${APP_BUNDLE}" ]]; then
  /bin/rm -rf "${APP_BUNDLE}"
fi

mkdir -p "${MACOS_DIR}" "${RESOURCES_DIR}"
cp "${BIN_DIR}/FollowUpOSNative" "${MACOS_DIR}/FollowUpOSNative"
cp "${PACKAGE_ROOT}/Resources/Info.plist" "${CONTENTS_DIR}/Info.plist"
ICON_SOURCE="${PACKAGE_ROOT}/Sources/FollowUpOSNative/Resources/logoContextWard.png"
ICONSET_DIR="$(mktemp -d "${TMPDIR:-/tmp}/contextward-iconset.XXXXXX")"
trap 'rm -rf "${ICONSET_DIR}"' EXIT
mkdir -p "${ICONSET_DIR}/Contextward.iconset"
for SIZE in 16 32 128 256 512; do
  /usr/bin/sips -z "${SIZE}" "${SIZE}" "${ICON_SOURCE}" --out "${ICONSET_DIR}/Contextward.iconset/icon_${SIZE}x${SIZE}.png" >/dev/null
  DOUBLE_SIZE=$((SIZE * 2))
  /usr/bin/sips -z "${DOUBLE_SIZE}" "${DOUBLE_SIZE}" "${ICON_SOURCE}" --out "${ICONSET_DIR}/Contextward.iconset/icon_${SIZE}x${SIZE}@2x.png" >/dev/null
done
/usr/bin/sips -z 1024 1024 "${ICON_SOURCE}" --out "${ICONSET_DIR}/Contextward.iconset/icon_512x512@2x.png" >/dev/null
/usr/bin/iconutil -c icns "${ICONSET_DIR}/Contextward.iconset" -o "${RESOURCES_DIR}/Contextward.icns"
RESOURCE_BUNDLE="${BIN_DIR}/FollowUpOSNative_FollowUpOSNative.bundle"
if [[ ! -d "${RESOURCE_BUNDLE}" ]]; then
  print -u2 "Missing SwiftPM resource bundle: ${RESOURCE_BUNDLE}"
  exit 1
fi
cp -R "${RESOURCE_BUNDLE}" "${RESOURCES_DIR}/"
chmod 755 "${MACOS_DIR}/FollowUpOSNative"

# Ad-hoc signature with hardened runtime and App Sandbox (F2). Developer ID
# signing and notarization need an Apple identity this Mac does not have.
ENTITLEMENTS="${PACKAGE_ROOT}/Resources/Contextward.entitlements"
codesign --force --options runtime --entitlements "${ENTITLEMENTS}" --timestamp=none --sign - "${APP_BUNDLE}"
codesign --verify --deep --strict --verbose=2 "${APP_BUNDLE}"

print "Built native app: ${APP_BUNDLE}"
print "Persistent data (sandboxed): ${HOME}/Library/Containers/com.pharos.contextward/Data/Library/Application Support/Contextward/workspace.json"
