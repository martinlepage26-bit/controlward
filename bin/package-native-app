#!/bin/zsh
set -euo pipefail

SCRIPT_DIR="${0:A:h}"
PROJECT_ROOT="${SCRIPT_DIR:h}"
APP_BUNDLE="${PROJECT_ROOT}/native-crm/dist/ControlWard.app"
RELEASE_DIR="${PROJECT_ROOT}/native-crm/release"
"${PROJECT_ROOT}/bin/build-native-app"

# Name the archive from the stamped bundle, not the source plist.
BUILT_PLIST="${APP_BUNDLE}/Contents/Info.plist"
VERSION="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "${BUILT_PLIST}")"
BUILD="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "${BUILT_PLIST}")"
COMMIT="$(/usr/libexec/PlistBuddy -c 'Print :ControlWardGitCommit' "${BUILT_PLIST}")"
ARCHIVE="${RELEASE_DIR}/ControlWard-${VERSION}-${BUILD}-${COMMIT[1,7]}-macOS.zip"
codesign --verify --deep --strict --verbose=2 "${APP_BUNDLE}"

mkdir -p "${RELEASE_DIR}"
ditto -c -k --sequesterRsrc --keepParent "${APP_BUNDLE}" "${ARCHIVE}"
shasum -a 256 "${ARCHIVE}" > "${ARCHIVE}.sha256"

unpacked="$(mktemp -d "${TMPDIR:-/tmp}/contextward-release.XXXXXX")"
trap 'rm -rf "${unpacked}"' EXIT
ditto -x -k "${ARCHIVE}" "${unpacked}"
codesign --verify --deep --strict --verbose=2 "${unpacked}/ControlWard.app"

print "Release archive: ${ARCHIVE}"
print "SHA-256: $(cut -d ' ' -f 1 "${ARCHIVE}.sha256")"
