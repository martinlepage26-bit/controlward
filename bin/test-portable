#!/usr/bin/env bash
# Builds and runs the platform-neutral ControlWard tests (no SwiftUI, no AppKit).
# Runs on macOS and on Linux with a Swift 6 toolchain. GitHub Actions is not used.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(dirname "${SCRIPT_DIR}")"
SOURCE_ROOT="${PROJECT_ROOT}/native-crm/Sources/FollowUpOSNative"
TEST_ROOT="${PROJECT_ROOT}/native-crm/Tests"
BUILD_ROOT="${PROJECT_ROOT}/native-crm/.build/portable-tests"
mkdir -p "${BUILD_ROOT}"

source "${SCRIPT_DIR}/portable-sources.sh"

swiftc -D CONTEXTWARD_ACCEPTANCE -parse-as-library -swift-version 6 \
  "${PORTABLE_SOURCES[@]/#/${SOURCE_ROOT}/}" \
  "${PORTABLE_TESTS[@]/#/${TEST_ROOT}/}" \
  "${TEST_ROOT}/PortableMain.swift" \
  -o "${BUILD_ROOT}/PortableTests"

# Argus planted reds 9 and 10 are pharos-api vitest cases. If pharos-api's dependencies are installed, run that suite
# with a JSON report so the Swift tally can count them; otherwise set CW_PHAROS_PLANTED_REDS to a report you made.
if [[ -z "${CW_PHAROS_PLANTED_REDS:-}" && -x "${PROJECT_ROOT}/pharos-api/node_modules/.bin/vitest" ]]; then
  report="${BUILD_ROOT}/pharos-vitest.json"
  (cd "${PROJECT_ROOT}/pharos-api" && ./node_modules/.bin/vitest run --reporter=default --reporter=json --outputFile.json="${report}") || true
  export CW_PHAROS_PLANTED_REDS="${report}"
fi

"${BUILD_ROOT}/PortableTests" "$@"
