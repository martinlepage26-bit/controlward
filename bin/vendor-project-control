#!/usr/bin/env python3
"""Copy only the reviewed dashboard and its two tracked assets; never private state."""
import argparse
import hashlib
import json
from pathlib import Path
import shutil
import subprocess

ROOT = Path(__file__).resolve().parents[1]
DEST = ROOT / "native-crm/Sources/FollowUpOSNative/Resources/ProjectControl"
FILES = ("project-control.html", "assets/emerauld.png", "assets/space-souls.jpg")
parser = argparse.ArgumentParser()
parser.add_argument("source", nargs="?", type=Path)
parser.add_argument("--check", action="store_true")
args = parser.parse_args()
if args.check:
    manifest = json.loads((DEST / "source.json").read_text())
    assert set(manifest["files"]) == set(FILES), "Unexpected bundle file manifest"
    for name in FILES:
        assert hashlib.sha256((DEST / name).read_bytes()).hexdigest() == manifest["files"][name], f"Bundle drift: {name}"
    assert set(p.relative_to(DEST).as_posix() for p in DEST.rglob("*") if p.is_file()) == set(FILES) | {"source.json"}, "Unexpected bundled file"
    print("Project Control bundle hashes verified")
else:
    if args.source is None:
        parser.error("Provide a clean Project Control checkout, or --check")
    def git(*values):
        return subprocess.check_output(["git", "-C", str(args.source), *values], text=True).strip()
    assert not git("status", "--porcelain", "--", *FILES), "Commit dashboard changes before vendoring"
    manifest = {"repository": "martinlepage26-bit/project-control", "commit": git("rev-parse", "HEAD"), "files": {}}
    for name in FILES:
        git("ls-files", "--error-unmatch", name)
        target = DEST / name
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(args.source / name, target)
        manifest["files"][name] = hashlib.sha256(target.read_bytes()).hexdigest()
    (DEST / "source.json").write_text(json.dumps(manifest, indent=2) + "\n")
    print("Vendored Project Control " + manifest["commit"])
