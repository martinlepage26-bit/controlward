  "draft_forbidden": [
    {
      "rule": "legal_advice",
      "patterns": [
        "(?i)legal advice",
        "(?i)avis juridique",
        "(?i)conseil juridique",
        "(?i)you are (legally )?required to",
        "(?i)vous (êtes|etes) (légalement )?tenus? de",
        "(?i)you must comply",
        "(?i)vous devez vous conformer",
        "(?i)in violation of",
        "(?i)en contravention"
      ]
    },
    {
      "rule": "compliance_claims",
      "patterns": [
        "(?i)fully compliant",
        "(?i)guarantee[sd]? compliance",
        "(?i)garanti[rt]? (la )?conformité",
        "(?i)certified compliant",
        "(?i)100 ?% conforme",
        "(?i)conforme à 100",
        "(?i)(loi 25|casl|law 25)[- ]compliant",
        "(?i)we make you compliant"
      ]
    },
    {
      "rule": "patient_or_client_data",
      "patterns": [
        "(?i)\\bpatients?\\b",
        "(?i)dossier (médical|medical|client)",
        "(?i)medical record",
        "(?i)client file",
        "(?i)\\bdiagnos",
        "(?i)health card",
        "(?i)carte d'assurance maladie",
        "(?i)\\bNAM\\b"
      ]
    },
    {
      "rule": "pricing",
      "patterns": [
        "\\$ ?\\d",
        "\\d ?\\$",
        "(?i)\\b\\d+ ?(cad|usd)\\b",
        "(?i)\\bper hour\\b",
        "(?i)\\bde l'heure\\b",
        "(?i)\\btarifs?\\b",
        "(?i)\\bprix\\b",
        "(?i)\\bpricing\\b",
        "(?i)\\bprice\\b",
        "(?i)\\bdiscount\\b",
        "(?i)\\brabais\\b"
      ]
    }
  ],
