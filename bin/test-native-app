#!/bin/zsh
set -euo pipefail

SCRIPT_DIR="${0:A:h}"
PROJECT_ROOT="${SCRIPT_DIR:h}"
SOURCE_ROOT="${PROJECT_ROOT}/native-crm/Sources/FollowUpOSNative"
BUILD_ROOT="${PROJECT_ROOT}/native-crm/.build/native-smoke-tests"
TEST_BINARY="${BUILD_ROOT}/FollowUpOSNativeSmokeTests"

mkdir -p "${BUILD_ROOT}"
swiftc -D CONTEXTWARD_ACCEPTANCE -parse-as-library \
  "${SOURCE_ROOT}/Models.swift" \
  "${SOURCE_ROOT}/AppStore.swift" \
  "${SOURCE_ROOT}/Security.swift" \
  "${SOURCE_ROOT}/Integrations.swift" \
  "${SOURCE_ROOT}/Discovery.swift" \
  "${SOURCE_ROOT}/GTMModels.swift" \
  "${SOURCE_ROOT}/AccountIdentity.swift" \
  "${SOURCE_ROOT}/AccountScoring.swift" \
  "${SOURCE_ROOT}/GTMEvents.swift" \
  "${SOURCE_ROOT}/WorkspaceModulePolicy.swift" \
  "${SOURCE_ROOT}/ControlWardModels.swift" \
  "${SOURCE_ROOT}/ControlWardStore.swift" \
  "${SOURCE_ROOT}/OverviewModel.swift" \
  "${SOURCE_ROOT}/MailIntake.swift" \
  "${PROJECT_ROOT}/native-crm/Tests/OverviewModelTests.swift" \
  "${PROJECT_ROOT}/native-crm/Tests/WorkspaceModuleTests.swift" \
  "${PROJECT_ROOT}/native-crm/Tests/ControlWardTests.swift" \
  "${PROJECT_ROOT}/native-crm/Tests/SecurityTests.swift" \
  "${PROJECT_ROOT}/native-crm/Tests/IntegrationTests.swift" \
  "${PROJECT_ROOT}/native-crm/Tests/LeadInboxTests.swift" \
  "${PROJECT_ROOT}/native-crm/Tests/GapAnalysisTests.swift" \
  "${PROJECT_ROOT}/native-crm/Tests/KairosTests.swift" \
  "${PROJECT_ROOT}/native-crm/Tests/MailIntakeTests.swift" \
  "${PROJECT_ROOT}/native-crm/Tests/DiscoveryTests.swift" \
  "${PROJECT_ROOT}/native-crm/Tests/GTMTests.swift" \
  "${PROJECT_ROOT}/native-crm/Tests/CSVImportTests.swift" \
  "${PROJECT_ROOT}/native-crm/Tests/NativeSmokeTests.swift" \
  -o "${TEST_BINARY}"

"${TEST_BINARY}"
